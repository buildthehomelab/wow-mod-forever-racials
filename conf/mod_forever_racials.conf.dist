[worldserver]

########################################
# mod-forever-racials
#
# Racials for utility, classes for power. Every race keeps one active and one passive that add no
# damage, healing, hit, crit, haste or resources; every class gets a mastery (+hit and +crit) and
# a cooldown of its own instead. Racial resistances are gone, and profession racials make the
# profession faster instead of adding skill. The new spells need the client patch
# (tools/build_patch.py); without it players can't see or cast them.
########################################

#
#    ForeverRacials.Races.Enable
#        Description: The race half. With 0, every race gets its stock 3.3.5 racials back (the
#                     core teaches them again at the next login) and loses Shatter Curse, Touch of
#                     the Grave and Rapid Regeneration. Startup only: the stock racials are changed
#                     when the server starts. The client patch's tooltips stay either way.
#        Default:     1
#

ForeverRacials.Races.Enable = 1

#
#    ForeverRacials.Classes.Enable
#        Description: The class half. With 0, characters lose their class mastery and class
#                     cooldown at their next login. Startup only.
#        Default:     1
#

ForeverRacials.Classes.Enable = 1

#
#    ForeverRacials.Profession.SpeedPercent
#        Description: How much faster the profession racials make their profession, in percent
#                     of the cast time: Gnome Engineering, Draenei Jewelcrafting, Blood Elf
#                     Enchanting and Tauren Herbalism. Startup only. The client patch's tooltips
#                     say 25%.
#        Default:     25
#

ForeverRacials.Profession.SpeedPercent = 25

#
#    ForeverRacials.Mastery.HitPercent
#    ForeverRacials.Mastery.CritPercent
#        Description: Hit and crit, in whole percent, that a physical mastery gives with the
#                     class's weapons (and the druids' Feral Mastery in Cat and Bear Form). The
#                     crit counts for the hand doing the attack; the hit is on while any weapon
#                     slot holds one of the class's weapons. Startup only. The client patch's
#                     tooltips say 2% and 2%.
#        Default:     2, 2
#

ForeverRacials.Mastery.HitPercent = 2
ForeverRacials.Mastery.CritPercent = 2

#
#    ForeverRacials.Mastery.SpellHitPercent
#    ForeverRacials.Mastery.SpellCritPercent
#        Description: Spell hit and spell crit, in whole percent, from Spell Mastery (paladins,
#                     priests, death knights, shamans, mages, warlocks and druids). Spell hit is
#                     higher than melee's because the spell hit cap is 17%, not 8%. Startup only.
#                     The client patch's tooltips say 4% and 2%.
#        Default:     4, 2
#

ForeverRacials.Mastery.SpellHitPercent = 4
ForeverRacials.Mastery.SpellCritPercent = 2

#
#    ForeverRacials.Mastery.Warrior.Weapons
#    ForeverRacials.Mastery.Paladin.Weapons
#    ForeverRacials.Mastery.Hunter.Weapons
#    ForeverRacials.Mastery.Rogue.Weapons
#    ForeverRacials.Mastery.DeathKnight.Weapons
#    ForeverRacials.Mastery.Shaman.Weapons
#    ForeverRacials.Mastery.Caster.Weapons
#        Description: The weapons each class's mastery counts, as weapon types separated by
#                     commas. Caster is the priests', mages' and warlocks' Wand Mastery.
#                     0 One-Handed Axe, 1 Two-Handed Axe, 2 Bow, 3 Gun, 4 One-Handed Mace,
#                     5 Two-Handed Mace, 6 Polearm, 7 One-Handed Sword, 8 Two-Handed Sword,
#                     10 Staff, 13 Fist Weapon, 15 Dagger, 16 Thrown, 18 Crossbow, 19 Wand.
#                     Startup only. If you change a list, change WEAPONS in tools/build_patch.py
#                     and rebuild the patch, or the tooltips name the old weapons.
#        Default:     Warrior     "0,1,4,5,6,7,8,13" (axes, maces, swords, polearms, fist weapons)
#                     Paladin     "0,1,4,5,6,7,8" (axes, maces, swords, polearms)
#                     Hunter      "2,3,18" (bows, guns, crossbows)
#                     Rogue       "0,4,7,13,15" (one-handed axes, maces and swords, fist weapons,
#                                 daggers)
#                     DeathKnight "0,1,4,5,6,7,8" (axes, maces, swords, polearms)
#                     Shaman      "0,1,4,5,13,15" (axes, maces, fist weapons, daggers)
#                     Caster      "19" (wands)
#

ForeverRacials.Mastery.Warrior.Weapons = "0,1,4,5,6,7,8,13"
ForeverRacials.Mastery.Paladin.Weapons = "0,1,4,5,6,7,8"
ForeverRacials.Mastery.Hunter.Weapons = "2,3,18"
ForeverRacials.Mastery.Rogue.Weapons = "0,4,7,13,15"
ForeverRacials.Mastery.DeathKnight.Weapons = "0,1,4,5,6,7,8"
ForeverRacials.Mastery.Shaman.Weapons = "0,1,4,5,13,15"
ForeverRacials.Mastery.Caster.Weapons = "19"

#
#    ForeverRacials.TouchOfTheGrave.WeaponChance
#    ForeverRacials.TouchOfTheGrave.SpellChance
#        Description: Chance in percent that an Undead's damaging weapon attack (melee, ranged,
#                     wand, or a weapon ability) or harmful spell heals them. Damage over time
#                     never does, and nothing rolls while they're at full health. The client
#                     patch's tooltip says 5% and 10%.
#        Default:     5, 10
#

ForeverRacials.TouchOfTheGrave.WeaponChance = 5
ForeverRacials.TouchOfTheGrave.SpellChance = 10

#
#    ForeverRacials.TouchOfTheGrave.HealPercent
#    ForeverRacials.TouchOfTheGrave.MaxHealthPercent
#        Description: The heal is HealPercent of the damage the hit dealt, but never more than
#                     MaxHealthPercent of the Undead's max health. The target takes nothing extra.
#                     A 4000 hit with 22000 health heals 1000; a 600 hit heals 150. The client
#                     patch's tooltip says 25% and 5%.
#        Default:     25, 5
#

ForeverRacials.TouchOfTheGrave.HealPercent = 25
ForeverRacials.TouchOfTheGrave.MaxHealthPercent = 5

#
#    ForeverRacials.TouchOfTheGrave.Cooldown
#        Description: Minimum milliseconds between two heals. Mostly limits area spells, which
#                     roll once per target hit. A roll that fails doesn't start it. 0 for none.
#        Default:     3000
#

ForeverRacials.TouchOfTheGrave.Cooldown = 3000

#
#    ForeverRacials.SyncInterval
#        Description: Milliseconds between checks that each online character has the right
#                     racials and class spells (they're also checked at login). Needed for
#                     playerbots: its randomizer clears a random bot's spells while it's online
#                     and teaches back only the default and trainer ones. 0 checks at login only.
#        Default:     10000
#

ForeverRacials.SyncInterval = 10000
